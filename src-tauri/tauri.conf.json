{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AWS Tunnel Desk",
  "version": "0.2.1",
  "identifier": "io.github.awstunneldesk",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AWS Tunnel Desk",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AWS Tunnel Desk contributors",
    "category": "DeveloperTool",
    "shortDescription": "Manage local AWS Systems Manager tunnels.",
    "longDescription": "Discover AWS resources and manage approved local port-forwarding sessions through AWS Systems Manager Session Manager.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
